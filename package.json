    "jest-junit": "^16.0.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "spfx-fast-serve": "^4.0.2",
    "spfx-fast-serve-helpers": "~1.21.1",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
    "typescript": "~4.8.4",
    "webpack-merge": "^6.0.1"
  }
}
