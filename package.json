{
  "name": "spfx-template",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "configure": "node scripts/configure.js",
    "tailwind:build": "tailwindcss -c tailwind.config.js -i ./src/webparts/app/shared/css/tailwind.css -o ./src/webparts/app/shared/css/tailwind.generated.css --minify",
    "build": "gulp bundle",
    "version:bump": "node scripts/bump-version.js",
    "build:prod": "pnpm version:bump && gulp clean && gulp bundle --ship && gulp package-solution --ship",
    "clean": "gulp clean",
    "test": "gulp test",
    "serve": "pnpm run tailwind:build && fast-serve",
    "generate": "node scripts/generate.js",
    "generate:page": "node scripts/generate.js page",
    "generate:component": "node scripts/generate.js component",
    "generate:service": "node scripts/generate.js service",
    "generate:hook": "node scripts/generate.js hook",
    "generate:model": "node scripts/generate.js model"
  },
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=18.17.1 <19.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.72.10",
    "@griffel/react": "^1.5.32",
    "@hookform/resolvers": "^3.9.0",
    "@microsoft/decorators": "1.22.1",
    "@microsoft/sp-adaptive-card-extension-base": "1.22.1",
    "@microsoft/sp-application-base": "1.22.1",
    "@microsoft/sp-component-base": "1.22.1",
    "@microsoft/sp-core-library": "1.22.1",
    "@microsoft/sp-dialog": "1.22.1",
    "@microsoft/sp-http-msgraph": "1.22.1",
    "@microsoft/sp-lodash-subset": "1.22.1",
    "@microsoft/sp-office-ui-fabric-core": "1.22.1",
    "@microsoft/sp-property-pane": "1.22.1",
    "@microsoft/sp-webpart-base": "1.22.1",
    "@pnp/graph": "^4.0.0",
    "@pnp/logging": "^4.0.0",
    "@pnp/sp": "^4.0.0",
    "@pnp/spfx-controls-react": "3.19.0",
    "@pnp/spfx-property-controls": "^3.18.0",
    "@tanstack/react-query": "^4.36.1",
    "axios": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "0.477.0",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "react-hook-form": "^7.53.0",
