export type HideScope = 'sitepages' | 'specific-page';

export interface IHideUiConfig {
  enabled: boolean;
  scope: HideScope;
  targetPageSlug: string;
  hideLevels: {
    base: boolean;
    commandBar: boolean;
    socialBar: boolean;
    comments: boolean;
  };
}

export const hideUiConfig: IHideUiConfig = {
  enabled: true,
  scope: 'sitepages',
  targetPageSlug: '',
  hideLevels: {
    base: true,
    commandBar: true,
    socialBar: true,
    comments: true
  }
};
